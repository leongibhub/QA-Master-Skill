  "project": "Document release policy offline draft",
  "requirements": [
    {
      "id": "REQ-B",
      "text": "Batch size is strict integer on origin 0 step 1 with inclusive bounds 2 and 6.",
      "acceptance": "Integers 2 through 6 are accepted; below 2 or above 6 invalid (F-01).",
      "source": "source-facts.md",
      "dimension": "functional",
      "approved": false,
      "priority": "P1"
    },
    {
      "id": "REQ-D",
      "text": "Rebate depends on independent booleans member and settled.",
      "acceptance": "Rebate only for both true; all other combinations no rebate (F-02).",
      "source": "source-facts.md",
      "dimension": "functional",
      "approved": false,
      "priority": "P1"
    },
    {
      "id": "REQ-S",
      "text": "Initial DRAFT; submit reaches REVIEW, publish from REVIEW reaches terminal PUBLISHED; publish from DRAFT invalid.",
      "acceptance": "Status follows F-03 through F-06; unspecified pairs remain unspecified.",
      "source": "source-facts.md",
      "dimension": "functional",
      "approved": false,
      "priority": "P1"
    }
