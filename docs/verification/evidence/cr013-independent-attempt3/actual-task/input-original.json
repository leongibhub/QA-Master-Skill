            },
            {
              "id": "R-10",
              "when": {
                "member": true,
                "settled": false
              },
              "outcome_id": "NO_REBATE",
              "source_refs": [
                "F-02"
              ],
              "oracle_ref": "O-NOREBATE"
            },
            {
              "id": "R-11",
              "when": {
                "member": true,
                "settled": true
              },
              "outcome_id": "REBATE",
              "source_refs": [
                "F-02"
              ],
              "oracle_ref": "O-REBATE"
            }
          ]
        }
