        ],
        "source_refs": [
          "F-01"
        ],
        "spec": {
          "numeric_type": "integer",
          "origin": 0,
          "step": 1,
          "lower": {
            "value": 2,
            "inclusive": true
          },
          "upper": {
            "value": 6,
            "inclusive": true
          },
