        ],
        "source_refs": [
          "F-01"
        ],
        "spec": {
          "numeric_type": "integer",
          "origin": 0,
          "step": 1,
          "lower": {
            "value": 2,
            "inclusive": true
          },
          "upper": {
            "value": 6,
            "inclusive": true
          },
          "oracle_by_class": {
            "IN_DOMAIN": "O-valid",
            "LOWER_INVALID": "O-invalid",
            "UPPER_INVALID": "O-invalid"
          }
        }
      },
      {
        "id": "M-decision",
