      "title": "DRAFT initial; REVIEW; PUBLISHED terminal.",
      "dimension": "functional",
      "approved": false
    },
    {
      "id": "REQ-004",
      "title": "submit in DRAFT changes status to REVIEW, no guard declared.",
      "dimension": "functional",
      "approved": false
    },
    {
      "id": "REQ-005",
      "title": "publish in REVIEW changes status to PUBLISHED, no guard declared.",
      "dimension": "functional",
      "approved": false
    },
    {
      "id": "REQ-006",
      "title": "publish in DRAFT invalid; stays DRAFT. Other combinations unspecified.",
      "dimension": "functional",
      "approved": false
    }
  ],
