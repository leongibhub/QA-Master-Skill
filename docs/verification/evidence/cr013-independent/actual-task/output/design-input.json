{
  "project": "Document release policy offline draft",
  "requirements": [
    {
      "id": "REQ-001",
      "title": "Strict integer batch size 2 through 6 inclusive, step 1 origin 0.",
      "dimension": "functional",
      "approved": false
    },
    {
      "id": "REQ-002",
      "title": "Rebate allowed exactly when member and settled are true.",
      "dimension": "functional",
      "approved": false
    },
