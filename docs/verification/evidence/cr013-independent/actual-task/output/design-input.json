        "dimension": "functional",
        "requirement_ids": [
          "REQ-003",
          "REQ-004",
          "REQ-005",
          "REQ-006"
        ],
        "source_refs": [
          "F-03",
          "F-04",
          "F-05",
          "F-06"
        ],
        "spec": {
