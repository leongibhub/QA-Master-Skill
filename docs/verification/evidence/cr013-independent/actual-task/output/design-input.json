              ],
              "oracle_ref": "O-no"
            },
            {
              "id": "R-10",
              "when": {
                "member": true,
                "settled": false
              },
              "outcome_id": "NO_REBATE",
              "source_refs": [
                "F-02"
              ],
              "oracle_ref": "O-no"
            },
            {
              "id": "R-11",
              "when": {
                "member": true,
                "settled": true
              },
              "outcome_id": "REBATE_ALLOWED",
              "source_refs": [
                "F-02"
              ],
              "oracle_ref": "O-allow"
            }
          ]
        }
      },
      {
